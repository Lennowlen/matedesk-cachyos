{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "green",
      "2": "cyan"
    }
  },
  "display": {
    "separator": " ➜ "
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "green",
        "at": "white",
        "host": "cyan"
      }
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "green",
      "format": "CachyOS ARM64 (MateDesk Edition)"
    },
    {
      "type": "host",
      "key": "Device",
      "keyColor": "green",
      "format": "Huawei MatePad 12 X (HiSilicon Kirin)"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "Resolution",
      "keyColor": "green"
    },
    {
      "type": "de",
      "key": "DE",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "green"
    },
    {
      "type": "theme",
      "key": "Theme",
      "keyColor": "green"
    },
    {
      "type": "icons",
      "key": "Icons",
      "keyColor": "green"
    },
    {
      "type": "font",
      "key": "Font",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "cyan",
      "format": "HiSilicon Maleoon (VirGL Hardware Accelerated)"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "cyan"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
